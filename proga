#include <stdio.h>
#include <string.h>

int main() {
    char s[] = "programming";
    int len = strlen(s);

    int count[26] = {0};

    
    for (int i = 0; i < len; i++) {
        int index = s[i] - 'a';
        count[index]++;
    }

    printf("Буквы, которые встречаются ровно один раз: ");
    int unique_count = 0;

    
    for (int i = 0; i < len; i++) {
        int index = s[i] - 'a';
        if (count[index] == 1) {
            printf("%c ", s[i]);
            unique_count++;
        }
    }

    printf("\nCount: %d\n", unique_count);

    return 0;
}
