#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int **alloc_matrix(int n) {
    int **a = malloc(n * sizeof(int *));
    for (int i = 0; i < n; i++) {
        a[i] = malloc(n * sizeof(int));
    }
    return a;
}

void free_matrix(int **a, int n) {
    for (int i = 0; i < n; i++) {
        free(a[i]);
    }
    free(a);
}

void fill_matrix(int **a, int n) {
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            a[i][j] = rand() % 9 + 1;
        }
    }
}

void print_matrix(int **a, int n) {
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            printf("%3d", a[i][j]);
        }
        printf("\n");
    }
}

int **rotate_90(int **a, int n) {
    int **b = alloc_matrix(n);
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            b[j][n - 1 - i] = a[i][j];
        }
    }
    return b;
}

int **rotate_matrix(int **a, int n, int deg) {
    int times = deg / 90;
    int **current = a;

    for (int t = 0; t < times; t++) {
        int **next = rotate_90(current, n);
        if (current != a) {
            free_matrix(current, n);
        }
        current = next;
    }
    return current;
}

int main() {
    srand(time(NULL));

    int n;
    printf("Введите размер матрицы: ");
    scanf("%d", &n);

    int **a = alloc_matrix(n);
    fill_matrix(a, n);

    printf("\nИсходная матрица:\n");
    print_matrix(a, n);

    int choice;
    while (1) {
        printf("\nМеню:\n");
        printf("1 - Повернуть на 90\n");
        printf("2 - Повернуть на 180\n");
        printf("3 - Повернуть на 270\n");
        printf("0 - Выход\n");
        printf("Выбор: ");
        scanf("%d", &choice);

        if (choice == 0) break;

        int deg = choice * 90;
        int **b = rotate_matrix(a, n, deg);

        printf("\nПосле поворота на %d градусов:\n", deg);
        print_matrix(b, n);

        free_matrix(b, n);
    }

    free_matrix(a, n);
    return 0;
}
