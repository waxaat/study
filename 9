import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

t_stop = np.log(70 / 20) / 0.05         # ≈ 25.05 мин: T(t_stop) = 40
t = np.linspace(0, t_stop, 300)
T = 20 + 70 * np.exp(-0.05 * t)

fig, ax = plt.subplots(figsize=(6, 4.5))
ax.set_title('Чай остывает по закону Ньютона')
ax.set_xlabel('Минуты')
ax.set_ylabel('Температура, °C')
ax.set_xlim(0, 27)
ax.set_ylim(15, 95)
ax.grid(True, alpha=0.3)

ax.plot(t, T, color='saddlebrown', alpha=0.2, linewidth=2)   # «тень»

ax.axhline(40, ls='--', color='orange')                      # питьевая
ax.text(0.3, 41, 'питьевая 40°C', color='orange', fontsize=8)
ax.axhline(20, ls='--', color='blue')                        # комнатная
ax.text(13, 21, 'комнатная 20°C', color='blue', fontsize=8)

line, = ax.plot([], [], color='red', linewidth=2)
dot, = ax.plot([], [], 'ro', markersize=9)
txt = ax.text(0.3, 92, '', fontsize=9, va='top')

def update(frame):
    n = frame + 1
    line.set_data(t[:n], T[:n])
    dot.set_data([t[n-1]], [T[n-1]])
    txt.set_text(f't = {t[n-1]:.1f} мин\nT = {T[n-1]:.1f} °C')
    return line, dot, txt

ani = FuncAnimation(fig, update, frames=len(t), interval=30, repeat=False)
ani.save('tea.gif', writer='pillow', fps=30)
plt.show()
