ax.set_ylim(0, 210)
ax.grid(True, alpha=0.3)

ax.plot(x, R, alpha=0.2)                

line, = ax.plot([], [], color='red', linewidth=2)
dot, = ax.plot([], [], 'ro', markersize=9)
txt = ax.text(0.5, 195, '', fontsize=9)

def update(frame):
    n = frame + 1
    line.set_data(x[:n], R[:n])
    dot.set_data([x[n-1]], [R[n-1]])
    txt.set_text(f'цена = {x[n-1]:.1f}  выручка = {R[n-1]:.1f}')
