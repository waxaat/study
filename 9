import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

t = np.linspace(0, 2 * np.pi, 250)
x = 16 * np.sin(t) ** 3
y = 13 * np.cos(t) - 5 * np.cos(t*2) - 2 * np.cos(t*3) - np.cos(t*4)

fig, ax = plt.subplots(figsize = (6,6))
ax.set_xlim(-18, 18)
ax.set_ylim(-20, 20)
ax.set_aspect('equal')

ax.set_facecolor('blue')
fig.patch.set_facecolor('black')
ax.axis('on')
line, = ax.plot([], [], color = 'crimson', linewidth = 2)
dot, = ax.plot([], [],'o', color = 'white', markersize=5)

def update(frame):
    n = frame + 1
    line.set_data(x[:n], y[:n])         
    dot.set_data([x[n-1]], [y[n-1]])
    return line, dot

ani = FuncAnimation(fig, update, frames=len(x), interval=30)
ani.save('animation.gif', writer='pillow', fps=60)
plt.show()



