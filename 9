import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

fig, ax = plt.subplots(figsize=(5, 5))
ax.set_title('Случайное блуждание')
ax.grid(True, alpha=0.3)

xs, ys = [0], [0]

line, = ax.plot([], [], color='blue', linewidth=1, alpha=0.7)
dot, = ax.plot([], [], 'ro', markersize=8)

def update(frame):
    if frame == 0:                      
        xs[:] = [0]
        ys[:] = [0]
    else:                               
        xs.append(xs[-1] + np.random.uniform(-1, 1))
        ys.append(ys[-1] + np.random.uniform(-1, 1))

    line.set_data(xs, ys)
    dot.set_data([xs[-1]], [ys[-1]])

    ax.set_xlim(min(xs) - 1, max(xs) + 1)   
    ax.set_ylim(min(ys) - 1, max(ys) + 1)
    return line, dot

ani = FuncAnimation(fig, update, frames=100, interval=100, repeat=False)
ani.save('robot.gif', writer='pillow', fps=10)
plt.show()

