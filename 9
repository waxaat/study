import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

t_stop = 20 * np.log2(1000)             
t = np.linspace(0, t_stop, 400)
N = 2 ** (t / 20)

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(10, 4.5))
ax1.set_title('Обычная шкала: «незаметно → БУМ!»', fontsize=10)
ax2.set_title('Лог-шкала: ровная прямая', fontsize=10)
ax2.set_yscale('log')

for ax in (ax1, ax2):
    ax.set_xlim(0, t_stop)
    ax.set_xlabel('Минуты')
    ax.grid(True, alpha=0.3)
    ax.axhline(1000, ls='--', color='red')
    ax.plot(t, N, color='green', alpha=0.2)      

ax1.set_ylim(0, 1050)
ax2.set_ylim(1, 1500)
ax1.set_ylabel('Бактерий')
ax2.set_ylabel('Бактерий (log)')

line1, = ax1.plot([], [], color='green', linewidth=2)
dot1, = ax1.plot([], [], 'go', markersize=7)
line2, = ax2.plot([], [], color='green', linewidth=2)
dot2, = ax2.plot([], [], 'go', markersize=7)

txt1 = ax1.text(0.03, 0.95, '', transform=ax1.transAxes, va='top', fontsize=8)
txt2 = ax2.text(0.03, 0.95, '', transform=ax2.transAxes, va='top', fontsize=8)

last = len(t) - 1

def update(frame):
    n = frame + 1
    line1.set_data(t[:n], N[:n])
    line2.set_data(t[:n], N[:n])
    dot1.set_data([t[n-1]], [N[n-1]])
    dot2.set_data([t[n-1]], [N[n-1]])

    label = f't = {t[n-1]:.1f} мин\nN = {N[n-1]:.0f}'
    txt1.set_text(label)
    txt2.set_text(label)

    if frame == last:                   
        dot1.set_color('red')
        dot2.set_color('red')
        dot1.set_markersize(12)
        dot2.set_markersize(12)
        fig.suptitle(f'N = 1000 через {t_stop:.1f} мин '
                     f'({int(t_stop // 60)} ч {int(t_stop % 60)} мин)')
    else:                               
        dot1.set_color('green')
        dot2.set_color('green')
        dot1.set_markersize(7)
        dot2.set_markersize(7)
        fig.suptitle('')
    return line1, dot1, line2, dot2, txt1, txt2

fig.tight_layout(rect=[0, 0, 1, 0.94])

ani = FuncAnimation(fig, update, frames=len(t), interval=20, repeat=False)
ani.save('bacteria.gif', writer='pillow', fps=30)
plt.show()

