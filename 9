import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

S = np.linspace(2, 8, 400)
C = 12 / S

S_anim = np.linspace(8, 2, 300)         
C_anim = 12 / S_anim

fig, ax = plt.subplots(figsize=(6, 4.5))
ax.set_title('Сколько кофе нужно, чтобы выжить')
ax.set_xlabel('Часы сна S')
ax.set_ylabel('Чашек кофе C(S)')
ax.set_xlim(0, 8)
ax.set_ylim(0, 7)
ax.grid(True, alpha=0.3)

ax.plot(S, C, color='saddlebrown', alpha=0.2, linewidth=2)   
ax.axvline(0, ls='--', color='red')                          
ax.text(0.1, 6.9, 'S → 0:\nкофе → ∞', color='red', fontsize=8, va='top')

line, = ax.plot([], [], color='saddlebrown', linewidth=2)
dot, = ax.plot([], [], 'o', color='green', markersize=10)
txt = ax.text(7.9, 6.6, '', ha='right', fontsize=9)

def update(frame):
    s = S_anim[frame]
    c = C_anim[frame]

    line.set_data(S_anim[:frame + 1], C_anim[:frame + 1])
    dot.set_data([s], [c])

    if s > 5.5:                        
        dot.set_color('green')
    elif s > 3.5:
        dot.set_color('orange')
    else:
        dot.set_color('red')

    txt.set_text(f'сон = {s:.1f} ч   кофе = {c:.1f}')
    return line, dot, txt

ani = FuncAnimation(fig, update, frames=len(S_anim), interval=30, repeat=False)
ani.save('coffee.gif', writer='pillow', fps=30)
plt.show()

