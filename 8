ax2.set_ylabel('Заряд, %', fontsize=11)
ax2.set_xticks(days)
ax2.set_ylim(0, 100)
ax2.grid(True, alpha=0.4)
ax2.legend(loc='upper right', fontsize=9)

plt.tight_layout()
plt.savefig('phone.png', dpi=150)
plt.show()

