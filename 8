ax1.set_ylabel('Часы, ч', fontsize=11)
ax1.set_xticks(days)
ax1.set_ylim(0, 11)
ax1.grid(True, alpha=0.4)
ax1.legend(loc='upper left', fontsize=9)


ax2.plot(days, battery, color='tab:purple', linestyle='-', marker='s',
         linewidth=2, markersize=6, label='Заряд батареи')
