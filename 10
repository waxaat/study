import json

with open("servers.json", "r", encoding="utf-8") as f:
    servers = json.load(f)

stats = {"online": 0, "offline": 0, "maintenance": 0}
offline_servers = []

for name, status in servers.items():
    if status in stats:
        stats[status] += 1
    if status == "offline":
        offline_servers.append(name)

print("online:", stats["online"])
print("offline:", stats["offline"])
print("maintenance:", stats["maintenance"])
print("Упавшие серверы:", ", ".join(offline_servers))

