def text_to_t9(text):
    keypad = {
        '2': 'ABC',
        '3': 'DEF',
        '4': 'GHI',
        '5': 'JKL',
        '6': 'MNO',
        '7': 'PQRS',
        '8': 'TUV',
        '9': 'WXYZ',
        '0': ' '
    }
    
    char_map = {}
    for digit, letters in keypad.items():
        for index, letter in enumerate(letters, start=1):
            char_map[letter] = digit * index
            
    result = []
    for char in text.upper():
        if char in char_map:
            result.append(char_map[char])
            
    return "".join(result)

user_input = input()
print(text_to_t9(user_input))

