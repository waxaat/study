        print(song)
else:
    print("Такого жанра нет в плейлисте.")

new_song = input("Введите название нового трека: ")
new_genre = input("Введите жанр для нового трека: ")

if new_genre in playlist:
    playlist[new_genre].append(new_song)
else:
    playlist[new_genre] = [new_song]

with open("playlist.json", "w", encoding="utf-8") as f:
    json.dump(playlist, f, ensure_ascii=False, indent=4)

