participants = []

with open("olimp.txt", "r", encoding="utf-8") as f:
    for line in f:
        line = line.strip()
        if line:
            info, score_str = line.rsplit(maxsplit=1)
            participants.append((info, int(score_str)))

max_score = max(p for p in participants)
prize_score = max(p for p in participants if p < max_score)

for info, score in participants:
    if score == prize_score:
        print(info, score)
        break

#.4
with open("secret.txt", "r", encoding="utf-8") as f:
    lines = f.readlines()

result = []

for line in lines:
    line = line.strip()
    if not line:
        continue
    
    name_part, phone_part, email_part = line.split(", ")
    
    phone_prefix, phone = phone_part.split(": ")
    masked_phone = "*" * (len(phone) - 2) + phone[-2:]
    
    email_prefix, email = email_part.split(": ")
    login, domain = email.split("@")
    masked_email = login[0] + "***@" + domain
    
    new_line = f"{name_part}, {phone_prefix}: {masked_phone}, {email_prefix}: {masked_email}\n"
    result.append(new_line)

with open("secret_anonymized.txt", "w", encoding="utf-8") as f:
    f.writelines(result)

